{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cmake-build-release",
      "displayName": "Release with vcpkg",
      "binaryDir": "${sourceDir}/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "toolchain.cmake"
        },
        "CMAKE_BUILD_TYPE": {
          "value": "RelWithDebInfo"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-release",
      "configurePreset": "cmake-build-release",
      "configuration": "RelWithDebInfo"
    }
  ]
}